# Supabase Configuration
# Obtain these from your Supabase project dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Service Role Key (Used for server-side operations only - NEVER expose in frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clinic Defaults
NEXT_PUBLIC_CLINIC_PHONE=+91 70086 10481
NEXT_PUBLIC_CLINIC_NAME="Satyabhama Health Care"
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
